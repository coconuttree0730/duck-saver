{
  "title": "Duck Saver - Logs (Loki)",
  "uid": "duck-saver-logs",
  "timezone": "browser",
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "服务日志（按容器过滤）",
      "type": "logs",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 20, "w": 24, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "{container=~\"$container\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "错误日志",
      "type": "logs",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 20},
      "targets": [
        {
          "expr": "{container=~\"$container\"} |~ \"(?i)error|exception\"",
          "refId": "A"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "container",
        "type": "query",
        "datasource": {"type": "loki", "uid": "loki"},
        "query": "label_values(container)",
        "includeAll": true,
        "multi": true,
        "current": {"text": "All", "value": "$__all"}
      }
    ]
  },
  "schemaVersion": 39
}
